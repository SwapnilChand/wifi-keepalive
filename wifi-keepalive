#!/usr/bin/env bash
# Keep a captive-portal wifi session alive, log its state, and tell you when it needs a login.
set -u
URL=${WIFI_KEEPALIVE_URL:-http://connectivitycheck.gstatic.com/generate_204}
LOG=${XDG_STATE_HOME:-$HOME/.local/state}/wifi-keepalive.log
ON_CAPTIVE=${WIFI_KEEPALIVE_ON_CAPTIVE:-open}  # open | notify
mkdir -p "${LOG%/*}"

read -r code portal < <(curl -s -m 10 -o /dev/null -w '%{http_code} %{redirect_url}\n' "$URL")
gw=$(ip route show default | awk '{print $3; exit}')
# MikroTik hotspots (Third Wave, many cafes) expose "connected / left" at /status
session=$(curl -s -m 5 "http://$gw/status" | tr -d '\n' | sed -n 's|.*connected / left:</td><td>\([^<]*\)<.*|\1|p')

case $code in
  204) state=online ;;
  000) state=offline ;;
  *)   # Many portals (MikroTik mac-cookie) re-login automatically when you just load the login page,
       # which is what a browser refresh does. Do that, then check again.
       curl -s -m 10 -L -o "${LOG%/*}/wifi-keepalive-portal.html" "${portal:-http://$gw/}"  # kept for debugging logins
       if [ "$(curl -s -m 10 -o /dev/null -w '%{http_code}' "$URL")" = 204 ]; then
         state="relogged ${portal:-http://$gw/}"
       else
         state="captive ${portal:-http://$gw/}"
         # only act on the first captive run, not every minute until you log in
         if [ "$(tail -1 "$LOG" 2>/dev/null | cut -d' ' -f2)" != captive ]; then
           if [ "$ON_CAPTIVE" = open ] && command -v xdg-open >/dev/null; then
             xdg-open "${portal:-http://$gw/}" >/dev/null 2>&1 &
           elif command -v notify-send >/dev/null; then
             notify-send -u critical "Wifi needs login" "Open ${portal:-http://$gw/}"
           fi
         fi
       fi ;;
esac
echo "$(date -Is) $state gw=$gw ${session:+session=\"$session\"}" | tee -a "$LOG"
